{
  "model_name": "CodingAgent-20B",
  "model_size": "20B",
  "notes": "Throughput + memory recipe. The wins here are all lossless: fused SDPA attention (no [B, head, S, S] matrix, no fp32 materialisation), chunked LM-head loss (no [B, S, 128256] logits buffer in the training step; only the scalar loss is kept), prefetched + pinned data feeding, and ZeRO-3 without CPU offload so the optimizer step never round-trips through PCIe. Precision, learning rate, betas, weight decay, clipping, global batch, sequence length and data order are untouched.",

  "training": {
    "total_tokens": 300000000000,
    "learning_rate": 3e-4,
    "min_learning_rate": 3e-5,
    "warmup_tokens": 2000000000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-8,
    "max_grad_norm": 1.0,
    "precision": "bf16",
    "seed": 42,

    "steps_per_print": 10,
    "attention_backend": "auto",
    "chunked_loss": true,
    "loss_chunk_size": 1024,
    "logit_softcap": null
  },

  "batching": {
    "global_batch_size": 2048,
    "micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": "auto",
    "sequence_length": 8192,
    "long_sequence_length": 32768
  },

  "deepspeed": {
    "stage": 3,
    "offload_optimizer": false,
    "offload_param": false,
    "zero8bit_optimizer": false,
    "activation_checkpointing": true,
    "activation_checkpointing_segments": 2,
    "stage3_max_live_parameters": 1000000000,
    "stage3_max_reuse_distance": 1000000000,
    "stage3_param_persistence_threshold": 200000,
    "config_file": "configs/ds_config_zero3.json",
    "offload_config_file": "configs/ds_config_zero3_offload.json"
  },

  "data": {
    "data_dir": "data/processed",
    "num_workers": 4,
    "prefetch_factor": 2,
    "prefetch_depth": 3,
    "pin_memory": true
  },

  "compile": {
    "enabled": false,
    "mode": "reduce-overhead",
    "note": "torch.compile on the block stack; opt-in because it costs a few minutes of warmup on the first steps."
  },

  "checkpointing": {
    "save_dir": "checkpoints",
    "save_every_steps": 1000,
    "save_every_tokens": 1000000000,
    "keep_last_n": 5,
    "save_optimizer_state": true
  },

  "logging": {
    "log_every_steps": 10,
    "eval_every_steps": 500,
    "wandb_project": "coding-agent-20b",
    "wandb_entity": null,
    "tensorboard_dir": "logs/tensorboard"
  },

  "evaluation": {
    "eval_tokens": 10000000,
    "eval_batch_size": 8,
    "metrics": ["loss", "perplexity", "token_accuracy"]
  }
}
