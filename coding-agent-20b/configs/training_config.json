{
  "model_name": "CodingAgent-20B",
  "model_size": "20B",
  "training": {
    "total_tokens": 300000000000,
    "learning_rate": 0.0003,
    "min_learning_rate": 3e-05,
    "warmup_tokens": 2000000000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-08,
    "max_grad_norm": 1.0,
    "precision": "bf16",
    "seed": 42
  },
  "batching": {
    "global_batch_size": 2048,
    "micro_batch_size_per_gpu": 2,
    "gradient_accumulation_steps": "auto",
    "sequence_length": 32768,
    "long_sequence_length": 32768
  },
  "deepspeed": {
    "stage": 3,
    "offload_optimizer": true,
    "offload_param": true,
    "activation_checkpointing": true,
    "config_file": "configs/ds_config_zero3.json",
    "offload_policy": "auto"
  },
  "data": {
    "data_dir": "data/corpus_v1/shards_20b",
    "mixture_source": "dataset/mixture.DEFAULT_MIXTURE",
    "mixture": {
      "the-stack-code": 0.48,
      "github-issues": 0.06,
      "github-prs": 0.07,
      "tests": 0.07,
      "docs-and-comments": 0.05,
      "instruction-sft": 0.06,
      "security-sft": 0.03,
      "repair-trace-sft": 0.04,
      "app-sft": 0.05,
      "app-repair-sft": 0.03,
      "app-preference-dpo": 0.02,
      "recovery-sft": 0.02,
      "project-scaffold-sft": 0.02
    },
    "upsample": {
      "security-sft": 3.0,
      "repair-trace-sft": 2.5,
      "app-sft": 2.5,
      "app-repair-sft": 2.5
    },
    "num_workers": 4,
    "prefetch_factor": 2,
    "pin_memory": true,
    "synthetic_budget": {
      "synthetic_token_cap": 0.05,
      "synthetic_token_slices": [
        "security-sft",
        "repair-trace-sft",
        "app-sft",
        "app-repair-sft",
        "app-preference-dpo",
        "recovery-sft",
        "project-scaffold-sft"
      ],
      "synthetic_token_plan_share": 0.0105,
      "synthetic_document_share": 0.21,
      "drop_policy": "downsample synthetic slices deterministically (seed 42) before writing shards"
    }
  },
  "checkpointing": {
    "save_dir": "checkpoints",
    "save_every_steps": 1000,
    "save_every_tokens": 1000000000,
    "keep_last_n": 5,
    "save_optimizer_state": true
  },
  "logging": {
    "log_every_steps": 10,
    "eval_every_steps": 500,
    "wandb_project": "coding-agent-20b",
    "wandb_entity": null,
    "tensorboard_dir": "logs/tensorboard"
  },
  "evaluation": {
    "eval_tokens": 10000000,
    "eval_batch_size": 8,
    "metrics": [
      "loss",
      "perplexity",
      "token_accuracy"
    ]
  },
  "optimizations": {
    "fast_kernels": true,
    "share_rope_tables": true,
    "skip_redundant_position_ids": true,
    "fuse_mlp_down_projection": true,
    "sync_free_moe": true,
    "native_gqa_sdpa": true,
    "fused_linear_cross_entropy": true,
    "loss_chunk_tokens": 0,
    "loss_chunk_budget_bytes": 201326592,
    "disable_flops_profiler": true,
    "disable_cpu_activation_checkpointing": true,
    "preserve_bf16_communication": true,
    "auto_offload": true
  }
}
