{
  "model_name": "CodingAgent-3B",
  "model_size": "3B",
  "notes": "EXACT same architecture family as CodingAgent-20B, scaled to the 3B class. Width halved (6144->3072, 16384->7168, 48/8->24/4), depth 60->20, thinner SwiGLU MLP (intermediate 7168, ratio 2.33x), head_dim 128, RoPE 500k, sliding window 4096, vocab 128256 preserved. See model/config_3b.py for breakdown. Memory-lean pretraining recipe: 4096-token sequences (native 8192 / YaRN 32k / 64k contexts remain available for inference), micro-batch 1 per GPU with a 512 global batch, and ZeRO-3 with full CPU offload of both parameters and optimizer state. The 3B pretrainer uses its own 18B-token budget; shared data mixture settings are unchanged.",
  "training": {
    "total_tokens": 18000000000,
    "learning_rate": 0.0003,
    "min_learning_rate": 3e-05,
    "warmup_tokens": 1000000000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-08,
    "max_grad_norm": 1.0,
    "precision": "bf16",
    "seed": 42
  },
  "batching": {
    "global_batch_size": 512,
    "micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": "auto",
    "sequence_length": 4096
  },
  "deepspeed": {
    "stage": 3,
    "offload_optimizer": true,
    "offload_param": true,
    "activation_checkpointing": true,
    "stage3_max_live_parameters": 500000000,
    "stage3_max_reuse_distance": 500000000,
    "config_file": "configs/ds_config_zero3.json",
    "offload_policy": "auto"
  },
  "data": {
    "data_dir": "data/processed",
    "num_workers": 4,
    "prefetch_factor": 2,
    "pin_memory": true
  },
  "checkpointing": {
    "save_dir": "checkpoints-3b",
    "save_every_steps": 1000,
    "save_every_tokens": 500000000,
    "keep_last_n": 5,
    "save_optimizer_state": true
  },
  "logging": {
    "log_every_steps": 10,
    "eval_every_steps": 500,
    "wandb_project": "coding-agent-3b",
    "wandb_entity": null,
    "tensorboard_dir": "logs/tensorboard-3b"
  },
  "evaluation": {
    "eval_tokens": 10000000,
    "eval_batch_size": 8,
    "metrics": [
      "loss",
      "perplexity",
      "token_accuracy"
    ]
  },
  "optimizations": {
    "fast_kernels": true,
    "share_rope_tables": true,
    "skip_redundant_position_ids": true,
    "fuse_mlp_down_projection": true,
    "sync_free_moe": true,
    "native_gqa_sdpa": true,
    "fused_linear_cross_entropy": true,
    "loss_chunk_tokens": 0,
    "loss_chunk_budget_bytes": 201326592,
    "disable_flops_profiler": true,
    "disable_cpu_activation_checkpointing": true,
    "preserve_bf16_communication": true,
    "auto_offload": true
  }
}
